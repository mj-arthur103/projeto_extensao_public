{
  "manifest_version": 3,
  "name": "Leve — páginas mais leves",
  "short_name": "Leve",
  "version": "0.1.0",
  "description": "Deixa as páginas mais leves: você escolhe quais imagens baixar, imagens grandes demais são redimensionadas e o cache é limpo automaticamente.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Leve",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "browsingData",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"]
}
